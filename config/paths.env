# Central path config for the infinigen-rl pipeline. Source this before running
# anything:  `source config/paths.env`
# Edit the top block to relocate the pipeline to a new machine/checkout.

export REPO_ROOT=/nara-efs/marketing/shhsing/infinigen-rl         # this repo
export VERL_ROOT=/nara-efs/marketing/shhsing/verl                 # original verl checkout (model weights, cuda_compat, legacy output dirs)
export INFINIGEN_ROOT=/nara-efs/marketing/shhsing/infinigen       # infinigen checkout (renderer, patched)
export VENV=$VERL_ROOT/.venv                                      # training/sampling venv (torch, vllm, ray, transformers)
export INFINIGEN_VENV=$INFINIGEN_ROOT/rl_infinigen_beginner/venv  # driver venv for rendering (PIL + scaffold deps)

# VENDORED trainer: python -m verl.trainer.main_ppo resolves to this in-repo copy
# (external/verl, pinned commit — see external/verl/VENDORED.md). Override to use
# an external verl checkout instead.
export VERL_SRC=${VERL_SRC:-$REPO_ROOT/external/verl}

# Derived — usually leave as-is
export PY=$VENV/bin/python
export SCAFFOLD=$INFINIGEN_ROOT/rl_infinigen_beginner             # where gt_schemas/ references/ live
export DATA_ROOT=$VERL_ROOT/rl_infinigen_indoor/data              # merged train/val parquet
export CKPT_ROOT=$VERL_ROOT/rl_infinigen_bathroom/ckpts           # GRPO checkpoints land here
export TB_ROOT=$VERL_ROOT/rl_infinigen_bathroom/tb                # training TensorBoard logs
export BASE_MODEL=$VERL_ROOT/demo_qwen35_gsm8k/models/Qwen3.5-2B  # policy init (GSM8K-demo checkpoint)
export REWARD_PATH=$REPO_ROOT/src/reward_indoor.py               # custom GRPO reward (vendored in this repo)
export ROOMS="bathroom bedroom living kitchen dining"            # room types in the merged policy

# PYTHONPATH: vendored verl FIRST (so -m verl.trainer.main_ppo uses it), then the
# repo src/ (so reward_indoor + indoor_ontology + indoor_config_space resolve here).
export PYTHONPATH=$VERL_SRC:$REPO_ROOT/src:${PYTHONPATH:-}
